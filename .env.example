NEXT_PUBLIC_APP_NAME="Seoul Policy Data Map"
NEXT_PUBLIC_SOURCE_URL="https://github.com/Cozystone/Seoul-Policy-Data-Map"
SEOUL_OPEN_API_KEY=""

# MiroFish-Offline / SPDM local stack
MIROFISH_BACKEND_URL="http://localhost:5001"
MIROFISH_BACKEND_INTERNAL_URL=""
SPDM_EXECUTE_CORE="false"
SPDM_CORE_MAX_ROUNDS="1"
SPDM_CORE_PLATFORM="parallel"
LLM_API_KEY="ollama"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL_NAME="qwen2.5:7b"
NEO4J_URI="bolt://localhost:7688"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="mirofish"
EMBEDDING_MODEL="nomic-embed-text"
